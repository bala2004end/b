# ─────────────────────────────────────────────────────────────────────────────
# AI Database Assistant — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.*
!.env.example

# ── Maven / Java ─────────────────────────────────────────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/*.class
backend/*.jar
backend/*.war
*.log

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.eslintcache
frontend/*.local

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore override files
docker-compose.override.yml
docker-compose.local.yml
