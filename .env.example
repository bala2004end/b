# ============================================================
# AIDB Assistant — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.
# ============================================================

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Security
# Generate JWT secret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_REPLACE_WITH_64_BYTE_BASE64_ENCODED_RANDOM_STRING

# AES-256 key for encrypting DB passwords at rest
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_REPLACE_WITH_32_CHAR_KEY

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Production MySQL (only used when SPRING_PROFILES_ACTIVE=prod)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=aidb_prod
# DB_USERNAME=aidb_user
# DB_PASSWORD=your-secure-db-password
# MYSQL_ROOT_PASSWORD=your-mysql-root-password

# Optional overrides
# SQL_MAX_ROWS=500
# JWT_EXPIRATION_MS=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:5173
